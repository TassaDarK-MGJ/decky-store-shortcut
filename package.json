{
  "name": "decky-store-shortcut",
  "version": "1.0.0",
  "description": "Decky plugin: open the Steam store page of a library game from its context menu",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint:legacy": "node scripts/lint-legacy.mjs",
    "prebuild": "node scripts/lint-legacy.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "cdp": "node scripts/cdp.mjs",
    "deploy": "bash scripts/deploy.sh",
    "test": "vitest run"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck"
  ],
  "author": "Store Shortcut contributors",
  "license": "0BSD",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
